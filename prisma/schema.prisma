// This is your Prisma schema file for Reoti Handloom

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?    // Circle Avatar Image
  bannerImage String?    // Category Hero Banner Image
  parentId    String?
  parent      Category?  @relation("ParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("ParentChild")
  isParent    Boolean    @default(false)
  isHidden    Boolean    @default(false)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  description       String
  price             Float
  originalPrice     Float
  discountPercent   Int
  fabric            String   // e.g. "Silk Cotton", "Pure Silk", "Tissue Silk", "Cotton"
  weaveType         String   // e.g. "Garbha Reshami Weave", "Narmada Border", "Bugdi Border", "Zari Border"
  borderType        String   // e.g. "Gold Zari", "Silver Zari", "Tissue Zari", "Traditional"
  color             String
  blouseColor       String?  // e.g. "Contrast Maroon", "Running Match", "Golden Zari", "Black"
  designCode        String?  // e.g. "MS-SILVER-ZARI", "GARBHA-ROYAL" for grouping color variants
  lengthWithBlouse  String   @default("6.3 Meters (With Blouse Piece)")
  occasion          String   @default("Festive & Wedding")
  isFeatured        Boolean  @default(false)
  isBestSeller      Boolean  @default(false)
  isTrending        Boolean  @default(false)
  isAuthenticCraft  Boolean  @default(true)
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  stock             Int?
  isOutOfStock      Boolean  @default(false)
  images            String   // Stored as JSON string of image URLs
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  reviews           Review[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userName  String
  userEmail String?
  rating    Int      @default(5)
  comment   String
  image     String?  // Customer uploaded photo of received product
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  image     String
  link      String   @default("/products")
  tag       String?  // e.g. "FESTIVE SALE - 30% OFF", "ROYAL COLLECTION"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   @default("password123")
  phone     String?
  role      String   @default("user") // "user" | "admin"
  address   String?
  city      String?
  pincode   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  totalAmount     Float
  status          String   @default("PROCESSING") // PENDING, PROCESSING, SHIPPED, DELIVERED
  paymentMethod   String   @default("UPI") // UPI, CARD, COD
  paymentStatus   String   @default("PAID")
  items           String   // JSON string of cart items
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userEmail String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  type      String   // "VISIT" | "REGISTER" | "LOGIN" | "ORDER" | "INQUIRY"
  title     String
  details   String?
  userEmail String?
  userIp    String?
  pageUrl   String?
  createdAt DateTime @default(now())
}

model InstaPost {
  id        String   @id @default(uuid())
  handle    String   @default("reoti_handloom")
  image     String
  postUrl   String   @default("https://www.instagram.com/reoti_handloom")
  caption   String
  likes     String   @default("1,840")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

